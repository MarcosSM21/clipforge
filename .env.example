# ClipForge — Variables de entorno
# Copia este archivo como .env y ajusta los valores

# ── Ollama ──────────────────────────────────────────────────
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:32b

# ── Whisper ─────────────────────────────────────────────────
# WHISPER_MODEL=large-v3
# WHISPER_DEVICE=cuda
# WHISPER_COMPUTE_TYPE=float16

# ── Directorios ─────────────────────────────────────────────
# OUTPUT_DIR=./output
# TEMP_DIR=./temp

# ── Clips ───────────────────────────────────────────────────
# CLIPS_MIN_DURATION=20
# CLIPS_MAX_DURATION=60
# CLIPS_MAX_COUNT=5

# ── Plataforma ──────────────────────────────────────────────
# TARGET_PLATFORM=tiktok
# TIKTOK_COOKIES_PATH=./cookies.txt

# ── Vídeo de salida ─────────────────────────────────────────
# VIDEO_WIDTH=1080
# VIDEO_HEIGHT=1920
# VIDEO_FPS=30
